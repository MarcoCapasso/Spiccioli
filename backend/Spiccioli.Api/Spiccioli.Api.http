# ============================================================
# Spiccioli API - richieste di esempio
# Eseguire "Login utente 1", che fornisce il token alle altre richieste.
# ============================================================

@baseUrl = http://localhost:5046

# I token vengono letti dalle risposte dei login
@token = {{login.response.body.accessToken}}
@token2 = {{login2.response.body.accessToken}}

# Account di prova, SOLO per lo sviluppo: password inventate, non usate altrove
@testEmail = marco.prova@esempio.it
@testPassword = una password lunga

@test2Email = marco.prova2@esempio.it
@test2Password = una password lunga

# Dati di prova (dell'utente 1)
@transactionId = 6
@expenseCategoryId = 1
@incomeCategoryId = 2
@otherExpenseCategoryId = 3
# Categoria "Casa" dell'utente 1 (creata dall'onboarding): leggere l'Id dall'elenco delle categorie
@houseCategoryId = 1
# Spesa ricorrente di prova: impostare dopo averla creata
@recurringExpenseId = 3

# Da impostare prima di usare le richieste di eliminazione
@transactionToDeleteId = 0
@unusedCategoryId = 0


# ============================================================
# AUTENTICAZIONE 
# ============================================================

### Login utente 1 → 200 con il token
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{testEmail}}", "password": "{{testPassword}}" }

### Login utente 2 → 200 con il token
# @name login2
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{test2Email}}", "password": "{{test2Password}}" }

### Registrazione: email con spazi e maiuscole → 201
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Marco",
  "email": "  Marco.Prova3@Esempio.IT ",
  "password": "una password lunga"
}

### Email già registrata, con maiuscole diverse → 409
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Marco",
  "email": "MARCO.PROVA@esempio.it",
  "password": "una password lunga"
}

### Password troppo corta → 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Luca",
  "email": "luca.prova@esempio.it",
  "password": "corta"
}

### Password sbagliata → 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{testEmail}}", "password": "password sbagliata" }

### Email inesistente → 401 (stessa risposta della password sbagliata)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "nessuno@esempio.it", "password": "una password lunga" }

### Senza token → 401
GET {{baseUrl}}/api/transactions

# ============================================================
# PROFILO
# ============================================================

### Il mio profilo → 200
GET {{baseUrl}}/api/me
Authorization: Bearer {{token}}

### Le categorie proposte nell'onboarding → 200
GET {{baseUrl}}/api/me/default-categories
Authorization: Bearer {{token}}

### Completa l'onboarding → 200 con il profilo aggiornato
POST {{baseUrl}}/api/me/onboarding
Content-Type: application/json
Authorization: Bearer {{token2}}

{ "categoryNames": ["Alimentari", "Stipendio", "Svago"] }

### Onboarding ripetuto → 409
POST {{baseUrl}}/api/me/onboarding
Content-Type: application/json
Authorization: Bearer {{token2}}

{ "categoryNames": ["Casa"] }

### Categoria non prevista → 400
POST {{baseUrl}}/api/me/onboarding
Content-Type: application/json
Authorization: Bearer {{token}}

{ "categoryNames": ["Alimentari", "Viaggi spaziali"] }

### Utente con categorie già esistenti → 200, crea solo quelle mancanti
POST {{baseUrl}}/api/me/onboarding
Content-Type: application/json
Authorization: Bearer {{token}}

{ "categoryNames": ["Alimentari", "Casa", "Bollette"] }


# ============================================================
# TRANSAZIONI
# ============================================================

# ------------------------------------------------------------
# Lettura
# ------------------------------------------------------------

### Elenco paginato con i valori predefiniti (pagina 1, 20 elementi) → 200
GET {{baseUrl}}/api/transactions
Authorization: Bearer {{token}}

### Elenco filtrato per periodo e categoria, con paginazione → 200
GET {{baseUrl}}/api/transactions?from=2026-10-01&to=2026-10-31&categoryId={{expenseCategoryId}}&page=1&pageSize=5
Authorization: Bearer {{token}}

### Intervallo aperto: dal 1° ottobre in poi → 200
GET {{baseUrl}}/api/transactions?from=2026-10-01
Authorization: Bearer {{token}}

### Una transazione per Id → 200
GET {{baseUrl}}/api/transactions/{{transactionId}}
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Riepiloghi
# ------------------------------------------------------------

### Entrate, uscite e saldo di ottobre → 200
GET {{baseUrl}}/api/transactions/summary?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{token}}

### Totali per categoria di ottobre → 200
GET {{baseUrl}}/api/transactions/summary/by-category?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{token}}

### Periodo senza transazioni: tutti i totali a zero → 200
GET {{baseUrl}}/api/transactions/summary?from=2025-01-01&to=2025-12-31
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Scrittura (ATTENZIONE: modificano i dati)
# ------------------------------------------------------------

### Crea una spesa → 201, con intestazione Location
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 5.00,
  "date": "2026-10-13",
  "type": "Expense",
  "categoryId": {{expenseCategoryId}},
  "description": "Spesa di prova"
}

### Modifica una transazione (PUT: vanno inviati tutti i campi) → 200
PUT {{baseUrl}}/api/transactions/{{transactionId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 16.00,
  "date": "2026-10-10",
  "type": "Expense",
  "categoryId": {{otherExpenseCategoryId}},
  "description": "Spesa in negozio"
}

### Elimina una transazione → 204 (imposta prima @transactionToDeleteId)
DELETE {{baseUrl}}/api/transactions/{{transactionToDeleteId}}
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Errori attesi
# ------------------------------------------------------------

### Più errori di forma insieme: importo negativo, tipo mancante, categoria 0 → 400
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": -10,
  "date": "2026-10-13",
  "categoryId": 0,
  "description": "Prova validazione"
}

### Data mancante → 400
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 3.00,
  "type": "Expense",
  "categoryId": {{expenseCategoryId}},
  "description": "Senza data"
}

### Categoria inesistente → 400
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 5.00, "date": "2026-10-13", "type": "Expense", "categoryId": 999 }

### Uscita in una categoria di entrata → 400
POST {{baseUrl}}/api/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 5.00, "date": "2026-10-13", "type": "Expense", "categoryId": {{incomeCategoryId}} }

### Transazione inesistente → 404
GET {{baseUrl}}/api/transactions/999
Authorization: Bearer {{token}}

### Intervallo rovesciato → 400
GET {{baseUrl}}/api/transactions?from=2026-10-31&to=2026-10-01
Authorization: Bearer {{token}}

### Paginazione non valida → 400
GET {{baseUrl}}/api/transactions?page=0&pageSize=500
Authorization: Bearer {{token}}


# ============================================================
# CATEGORIE
# ============================================================

# ------------------------------------------------------------
# Lettura
# ------------------------------------------------------------

### Categorie attive, in ordine alfabetico → 200
GET {{baseUrl}}/api/categories
Authorization: Bearer {{token2}}

### Categorie comprese le archiviate → 200
GET {{baseUrl}}/api/categories?includeArchived=true
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Scrittura 
# ------------------------------------------------------------

### Crea una categoria: gli spazi esterni vengono tolti → 201
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "  Prova  ", "type": "Expense" }

### Cambia solo le maiuscole del nome → 200
PUT {{baseUrl}}/api/categories/{{otherExpenseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "TRASPORTI" }

### Riporta il nome originale → 200
PUT {{baseUrl}}/api/categories/{{otherExpenseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Trasporti" }

### Elimina una categoria mai usata: eliminazione fisica → 204
DELETE {{baseUrl}}/api/categories/{{unusedCategoryId}}
Authorization: Bearer {{token}}

### Elimina una categoria usata: viene archiviata → 204
DELETE {{baseUrl}}/api/categories/{{otherExpenseCategoryId}}
Authorization: Bearer {{token}}

### Ripristina una categoria archiviata → 200
POST {{baseUrl}}/api/categories/{{otherExpenseCategoryId}}/restore
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Errori attesi
# ------------------------------------------------------------

### Nome di soli spazi → 400
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "   ", "type": "Expense" }

### Nome già esistente, anche con maiuscole diverse → 409
POST {{baseUrl}}/api/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "trasporti", "type": "Expense" }

### Rinomina con il nome di un'altra categoria → 409
PUT {{baseUrl}}/api/categories/{{otherExpenseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Alimentari" }


# ============================================================
# ISOLAMENTO TRA UTENTI (Prima login 2)
# ============================================================

### L'utente 2 vede solo le sue transazioni → 200
GET {{baseUrl}}/api/transactions
Authorization: Bearer {{token2}}

### L'utente 2 chiede una transazione dell'utente 1 → 404
GET {{baseUrl}}/api/transactions/{{transactionId}}
Authorization: Bearer {{token2}}

# ============================================================
# SPESE RICORRENTI
# ============================================================

# ------------------------------------------------------------
# Lettura
# ------------------------------------------------------------

### Spese ricorrenti dell'utente, in ordine di nome → 200
GET {{baseUrl}}/api/recurring-expenses
Authorization: Bearer {{token}}

### Una spesa ricorrente per Id → 200 (imposta prima @recurringExpenseId)
GET {{baseUrl}}/api/recurring-expenses/{{recurringExpenseId}}
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Scrittura (ATTENZIONE: modificano i dati)
# ------------------------------------------------------------

### Crea un affitto mensile senza data di fine → 201 (imposta prima @houseCategoryId)
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Affitto",
  "amount": 650.00,
  "frequency": "Monthly",
  "startDate": "2026-01-01",
  "categoryId": {{houseCategoryId}}
}

###
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Assicurazione",
  "amount": 120.00,
  "frequency": "Quarterly",
  "startDate": "2025-11-10",
  "categoryId": {{houseCategoryId}}
}

### Modifica la spesa (PUT: vanno inviati tutti i campi) → 200
PUT {{baseUrl}}/api/recurring-expenses/{{recurringExpenseId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Assicurazione",
  "amount": 120.00,
  "frequency": "Quarterly",
  "startDate": "2025-11-10",
  "categoryId": {{houseCategoryId}}
}

### Elimina la spesa: mai usata → eliminazione fisica, già usata → terminazione; 204 in entrambi i casi
DELETE {{baseUrl}}/api/recurring-expenses/{{recurringExpenseId}}
Authorization: Bearer {{token}}

# ------------------------------------------------------------
# Errori attesi
# ------------------------------------------------------------

### Data di fine prima di quella di inizio → 400
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Rata errata",
  "amount": 100.00,
  "frequency": "Monthly",
  "startDate": "2026-06-01",
  "endDate": "2026-01-01",
  "categoryId": {{houseCategoryId}}
}

### Data di inizio mancante → 400
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Senza inizio",
  "amount": 100.00,
  "frequency": "Monthly",
  "categoryId": {{houseCategoryId}}
}

### Categoria di entrata → 400
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Spesa in Stipendio",
  "amount": 100.00,
  "frequency": "Monthly",
  "startDate": "2026-01-01",
  "categoryId": {{incomeCategoryId}}
}

### Frequenza non prevista → 400
POST {{baseUrl}}/api/recurring-expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Settimanale",
  "amount": 10.00,
  "frequency": "Weekly",
  "startDate": "2026-01-01",
  "categoryId": {{houseCategoryId}}
}

### Spesa ricorrente inesistente → 404
GET {{baseUrl}}/api/recurring-expenses/999
Authorization: Bearer {{token}}


# ============================================================
# PIANI MENSILI
# ============================================================

### Apre ottobre: la prima volta lo crea → 201
POST {{baseUrl}}/api/budgets/2026/10
Authorization: Bearer {{token}}

### Apre di nuovo ottobre: esiste già → 200, stesso piano
POST {{baseUrl}}/api/budgets/2026/10
Authorization: Bearer {{token}}

### Apre febbraio 2027 → 201, con affitto e assicurazione
POST {{baseUrl}}/api/budgets/2027/2
Authorization: Bearer {{token}}

### Apre novembre → 201
POST {{baseUrl}}/api/budgets/2026/11
Authorization: Bearer {{token}}

### Mese non valido → 400
POST {{baseUrl}}/api/budgets/2026/13
Authorization: Bearer {{token}}

### Oltre dodici mesi nel futuro → 400
POST {{baseUrl}}/api/budgets/2027/11
Authorization: Bearer {{token}}

### Imposta entrate e risparmio di novembre → 200
PUT {{baseUrl}}/api/budgets/2026/11
Content-Type: application/json
Authorization: Bearer {{token}}

{ "plannedIncome": 1800.00, "savingsTarget": 300.00 }

### Imposta la voce di Alimentari: la crea → 200
PUT {{baseUrl}}/api/budgets/2026/11/allocations/{{expenseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 300.00 }

### Imposta di nuovo la voce di Alimentari: la aggiorna → 200
PUT {{baseUrl}}/api/budgets/2026/11/allocations/{{expenseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 350.00 }

### Voce a zero per Casa: "ho deciso di non spendere" → 200
PUT {{baseUrl}}/api/budgets/2026/11/allocations/{{houseCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 0 }

### Voce in una categoria di entrata → 400
PUT {{baseUrl}}/api/budgets/2026/11/allocations/{{incomeCategoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "amount": 100.00 }

### Modifica di un piano mai aperto → 404
PUT {{baseUrl}}/api/budgets/2026/9
Content-Type: application/json
Authorization: Bearer {{token}}

{ "plannedIncome": 1000.00, "savingsTarget": 0 }

### Toglie la voce di Casa → 204
DELETE {{baseUrl}}/api/budgets/2026/11/allocations/{{houseCategoryId}}
Authorization: Bearer {{token}}

### Apre dicembre: copia novembre → 201
POST {{baseUrl}}/api/budgets/2026/12
Authorization: Bearer {{token}}
